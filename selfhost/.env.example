# Settings for the leaderboard. The easy way to create this file is:  ./setup.sh
# Put values with spaces or special characters in double quotes, e.g. COLLEGE_NAME="St. John's College".
# Inside double quotes write \\ for a backslash, \" for a quote and \$ for a dollar sign.

# ---- Your college ----
COLLEGE_NAME=
# Who may sign up, e.g. mycollege.ac.in  (several: a.ac.in,b.ac.in). Subdomains are included.
# Leave empty ONLY if anyone should be able to register.
COLLEGE_EMAIL_DOMAINS=
# This person becomes the admin. They sign in with an emailed code.
COLLEGE_ADMIN_EMAIL=

# ---- Secrets (setup.sh generates these) ----
# Letters and digits only: it is placed inside a connection URL.
POSTGRES_PASSWORD=
# Signs login sessions:  openssl rand -hex 48
JWT_SECRET=

# ---- Email: login codes are sent by email, so the site needs a mailbox ----
# Option 1: Gmail / Google Workspace. Use an App Password (Google Account > Security > 2-Step Verification > App passwords).
EMAIL_USER=
EMAIL_PASS=
# Option 2: any other mail server (college mail server, Microsoft 365, SES, Brevo...). Set SMTP_HOST and leave Option 1 empty.
# SMTP_HOST=smtp.yourcollege.edu
# SMTP_PORT=587          # 465 uses TLS automatically
# SMTP_USER=
# SMTP_PASS=
# What students see as the sender:
# EMAIL_FROM="\"College Leaderboard\" <noreply@yourcollege.edu>"

# ---- Address ----
# With a domain, HTTPS is set up automatically (point its DNS A record at this server first; ports 80 and 443 must be open).
# Without one the site runs on http://<server>:WEB_PORT.
DOMAIN=
# Set together with DOMAIN by setup.sh:
# COMPOSE_PROFILES=https
# WEB_BIND=127.0.0.1
# Port the site is published on when there is no DOMAIN (e.g. 8080). Apply a change with: docker compose up -d
WEB_PORT=3000

# ---- Other ----
# Decides when "solved today" rolls over. IANA name, e.g. Asia/Kolkata
APP_TIMEZONE=UTC
# URL-safe name of the college (rarely needs changing)
# COLLEGE_SLUG=college
# TRUST_PROXY=1

# Per client IP. Raise these if you run WITHOUT HTTPS/Caddy and many students share one network.
# RATE_LIMIT_CODES_PER_HOUR=10
# RATE_LIMIT_VERIFY_PER_15_MIN=30
