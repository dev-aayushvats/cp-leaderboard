# Backend API base URL (as the BROWSER reaches it)
NEXT_PUBLIC_API_BASE_URL=http://localhost:5000

# Optional: API address as the Next.js SERVER reaches it, if different (e.g. a docker network
# name like http://api:5000). Defaults to NEXT_PUBLIC_API_BASE_URL.
# API_INTERNAL_URL=

# Optional: pin this deployment to ONE college, ignoring the hostname (single-college
# installs / local dev). Leave unset to pick the college from the hostname:
#   mit.yoursite.com -> MIT, or a college's own custom domain.
# NEXT_PUBLIC_COLLEGE_SLUG=
