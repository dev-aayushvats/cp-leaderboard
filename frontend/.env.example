# --- The browser -> API connection ---
# By default (leave unset) the browser calls same-origin /api and this app's server forwards it to
# API_INTERNAL_URL below. That works for every subdomain/custom domain with no CORS, and lets one
# prebuilt image serve any deployment.
# NEXT_PUBLIC_API_BASE_URL=http://localhost:5000   # (build-time) call a separate API origin directly instead

# Where this app's SERVER reaches the API (runtime): used by the /api proxy and for server-side rendering.
# e.g. http://localhost:5000 locally, http://api:5000 in docker.
API_INTERNAL_URL=http://localhost:5000

# Optional: pin this deployment to ONE college, ignoring the hostname (single-college installs /
# local dev). Leave unset to pick the college from the hostname:
#   mit.yoursite.com -> MIT, or a college's own custom domain.
# NEXT_PUBLIC_COLLEGE_SLUG=
