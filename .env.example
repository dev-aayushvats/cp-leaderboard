# Settings for `docker compose up -d --build`. Copy to .env and fill in. (Never commit .env.)

# ---- Required ----
# Use letters and digits only: it's placed inside a connection URL.
POSTGRES_PASSWORD=
# Signs login sessions. Generate one:  openssl rand -hex 48
JWT_SECRET=

# ---- Email (login codes are emailed) ----
# A Gmail address plus an App Password (Google Account -> Security -> 2-Step Verification -> App passwords).
EMAIL_USER=
EMAIL_PASS=
# EMAIL_FROM="My College Leaderboard" <you@gmail.com>

# ---- Mode A: ONE college (simplest) ----
# Everyone who opens the site sees this college. Created on first start if missing.
COLLEGE_SLUG=
COLLEGE_NAME=
# Who may sign up, e.g. mit.edu or mit.edu,alum.mit.edu. Empty = anyone can register.
COLLEGE_EMAIL_DOMAINS=
# This person becomes the college admin; they sign in with an emailed code.
COLLEGE_ADMIN_EMAIL=
# COLLEGE_ADMIN_NAME=

# ---- Mode B: MANY colleges, one subdomain each (leave COLLEGE_SLUG empty) ----
# mit.<ROOT_DOMAIN>, iit.<ROOT_DOMAIN>, ... (needs wildcard DNS + TLS, see README)
ROOT_DOMAIN=
# Platform operators: sign in at /platform with an emailed code to create and manage colleges.
SUPERADMIN_EMAILS=

# ---- Other ----
# Timezone that decides when "solved today" rolls over (IANA name, e.g. Asia/Kolkata)
APP_TIMEZONE=UTC
# Port the site is published on
WEB_PORT=3000
# How many reverse proxies sit in front (HTTPS proxy / load balancer). Leave at 1 behind one proxy.
TRUST_PROXY=1

# ---- Rate limits (per client IP) ----
# These need your reverse proxy to pass each visitor's real IP in X-Forwarded-For (HTTPS proxies such as
# Caddy, nginx and Traefik do this by default). With NO proxy in front (e.g. a LAN demo on http://host:3000)
# every visitor looks like one IP and shares one limit, so raise these for such installs.
RATE_LIMIT_CODES_PER_HOUR=10
RATE_LIMIT_VERIFY_PER_15_MIN=30
