# Postgres connection string (Neon or any Postgres)
DATABASE_URL=postgres://user:password@host:5432/dbname
# Set to "false" when using a local Postgres without SSL
DATABASE_SSL=true

# Required. Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Gmail app password used to send OTP emails
EMAIL_USER=
EMAIL_PASS=
# Optional display sender, e.g. "My College Leaderboard" <you@gmail.com>
EMAIL_FROM=
# Not using Gmail? Set SMTP_HOST to use any SMTP server instead (login = SMTP_USER/SMTP_PASS, which
# default to EMAIL_USER/EMAIL_PASS; port 465 uses TLS automatically, override with SMTP_SECURE=true|false).
# SMTP_HOST=smtp.yourcollege.edu
# SMTP_PORT=587

PORT=5000
# College used when a request has no X-College-Slug header (single-college deployments)
DEFAULT_COLLEGE_SLUG=
# Set when behind a reverse proxy (e.g. 1) so rate limits use real client IPs
TRUST_PROXY=
# Per-IP limits (defaults shown). Raise them if you run without a reverse proxy: every visitor then shares one IP.
# RATE_LIMIT_CODES_PER_HOUR=10
# RATE_LIMIT_VERIFY_PER_15_MIN=30

# --- Sync worker (npm run worker | npm run worker:schedule) ---
# IANA timezone that decides when "questions solved today" rolls over, e.g. Asia/Kolkata
APP_TIMEZONE=UTC
# How often the scheduled worker syncs (cron syntax). Default: hourly
SYNC_CRON=0 * * * *
# The admin panel warns when no sync has succeeded for this many hours. Raise it if you sync less often than hourly.
# SYNC_STALE_HOURS=3

# --- Hosting many colleges ---
# Serve each college at <slug>.<ROOT_DOMAIN> (needs wildcard DNS *.ROOT_DOMAIN -> this app).
# Leave unset for a single-college install. (*.localhost always works for local testing.)
ROOT_DOMAIN=

# --- Platform console (/platform) ---
# Operator email(s), comma-separated. They sign in with an emailed code and can create and manage
# colleges from the UI. Leave empty to disable the console (use the college:add / admin:add CLI instead).
SUPERADMIN_EMAILS=
